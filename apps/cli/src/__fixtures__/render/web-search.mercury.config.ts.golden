/**
 * This app's composition: the tool plugins and channels it runs, the auth
 * provider when a channel needs one, how the lists its plugins hand over read,
 * and the assistant's persona. The entrypoints
 * (`src/index.ts`, `src/repl.ts`) hand this config to `composeMercury`.
 *
 * Every tool plugin and channel declared here is active.
 */
import { defineMercuryConfig } from "@mercury-fw/core";
import { webSearchPlugin } from "@mercury-fw/plugin-web-search";
import { searxngBackend } from "@mercury-fw/web-search-searxng";
import { httpChannel } from "@mercury-fw/channel-http";
import { staticAuth } from "@mercury-fw/auth-static";
import identity from "./persona/identity.md" with { type: "text" };
import tone from "./persona/tone.md" with { type: "text" };

export default defineMercuryConfig({
  persona: { name: "Mercury", identity, tone },
  plugins: [
    webSearchPlugin({
      backend: searxngBackend({ url: process.env.SEARXNG_URL || "http://searxng:8080" }),
      // Hosts whose pages anyone may read without being asked; each covers its subdomains.
      allowedHosts: [],
    }),
  ],
  channels: [httpChannel],
  auth: staticAuth,
});
