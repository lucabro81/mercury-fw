/**
 * This app's composition: the tool plugins and channels it runs, the auth
 * provider when a channel needs one, how the lists its plugins hand over read,
 * the assistant's persona and the languages it speaks (`i18n`: a file per
 * language in `locales/`, `en.json` overriding the English texts) and its version
 * (`version`, its `package.json`'s, shown on the HTTP channel's `/version`) and where
 * the traces of what it does go (`traces`). The entrypoints
 * (`src/index.ts`, `src/repl.ts`) hand this config to `composeMercury`.
 *
 * Every tool plugin and channel declared here is active.
 */
import { defineMercuryConfig, envBoolean, envNumber, ollamaEmbedding, ollamaModel } from "@mercury-fw/core";
import en from "./locales/en.json";
import pkg from "./package.json";
import { webSearchPlugin } from "@mercury-fw/plugin-web-search";
import { searxngBackend } from "@mercury-fw/web-search-searxng";
import { httpChannel } from "@mercury-fw/channel-http";
import { staticAuth } from "@mercury-fw/auth-static";
import { jsonlTraces } from "@mercury-fw/trace-jsonl";
import { qdrantConversations, qdrantIndex } from "@mercury-fw/store-qdrant";
import { conversationWindow } from "@mercury-fw/conversation-window";
import { wiki } from "@mercury-fw/wiki";
import { archive } from "@mercury-fw/archive";
import { titles } from "@mercury-fw/titles";
import { profile } from "@mercury-fw/profile";
import { memory } from "@mercury-fw/memory";
import { corrections } from "@mercury-fw/corrections";

/** The assistant's name: what the persona calls it, and every text the model reads. */
const name = "Mercury";

/**
 * The model the assistant runs on, from .env: a setting left empty is the
 * model's own (thinking stays on); capacity, how many requests its runtime
 * serves at once, is 1, and so is backgroundSlots, how many of them the work
 * nobody waits on may take.
 */
const main = ollamaModel(process.env.OLLAMA_MODEL, {
  think: envBoolean("OLLAMA_THINK", true),
  temperature: envNumber("OLLAMA_TEMPERATURE"),
  topP: envNumber("OLLAMA_TOP_P"),
  topK: envNumber("OLLAMA_TOP_K"),
  capacity: envNumber("OLLAMA_CAPACITY"),
  backgroundSlots: envNumber("OLLAMA_BACKGROUND_SLOTS"),
});

/**
 * The team's wiki: notes everyone shares (`curated/`) and each person's own,
 * in the vault at WIKI_VAULT_PATH, its index read at the start of each
 * session and the vault reviewed every night at 03:00.
 */
const teamWiki = wiki();

/**
 * What the assistant remembers of its conversations with each person: a
 * summary every few messages and when a conversation closes, the facts
 * about them it finds (promoted to their notes in the wiki), the last
 * conversation's summary at the start of a new one, and recall_verbatim.
 */
const longTermMemory = memory({ wiki: teamWiki });

/**
 * The conversation each session keeps for the model: its recent messages,
 * summarized on the model once they pass 60000 characters, and the end of a
 * conversation the person reopens, from the conversation store, with the
 * memory's summaries of what came before it.
 */
const conversation = conversationWindow({ earlier: longTermMemory });

/*
 * Also declared in `plugins`: `archive()` keeps every conversation as it was
 * said, in the conversation store, so a person reopens and lists it;
 * `titles()` names each one after its first turn; `profile()` lets the
 * assistant save how each person wants to be called, their time zone and
 * their language; `corrections()` learns from a command that failed and the
 * one that worked, and writes the rule in the wiki. Remove one to do
 * without what it does.
 */

export default defineMercuryConfig({
  persona: {
    name,
    identity: `You are ${name}, an internal assistant.`,
    tone: [
      "DO:",
      "- Answer directly, in plain text only.",
      "- Be dry but respectful, and complete.",
      "- If you believe a point of view is useful, add it — but keep it brief and put it strictly at the end.",
      "",
      "DON'T:",
      "- DON'T use Markdown formatting (no **, #, -, etc.), unless the user explicitly asks for it.",
      `- DON'T introduce yourself as ${name} unless asked; the user already knows who you are.`,
      "- DON'T ask follow-up questions.",
      "- DON'T add extra explanations or extra actions beyond what was requested.",
    ].join("\n"),
  },
  plugins: [
    conversation,
    teamWiki,
    longTermMemory,
    archive(),
    titles(),
    profile(),
    corrections({ wiki: teamWiki }),
    webSearchPlugin({
      backend: searxngBackend({ url: process.env.SEARXNG_URL || "http://searxng:8080" }),
      // Hosts whose pages anyone may read without being asked; each covers its subdomains.
      allowedHosts: [],
    }),
  ],
  channels: [httpChannel],
  auth: staticAuth,
  // Where the memory is found by meaning (what past conversations were about,
  // what the agent learned about each person, the corrections to how a tool
  // is used, and searching past messages): Qdrant, the compose service.
  // Remove to keep no memory.
  vectorIndex: qdrantIndex(),
  // Where what was said is kept: every conversation, to reopen and list it,
  // and its title. Qdrant, the compose service. Remove to archive nothing.
  conversationStore: qdrantConversations(),
  // The models it runs on, by role: the turns on `main`, and the work no one
  // waits on too unless a `background` model is added here; the memory
  // found by meaning is embedded with `embedding`.
  models: {
    turn: main,
    embedding: ollamaEmbedding(process.env.OLLAMA_EMBEDDING_MODEL ?? "nomic-embed-text"),
  },
  // What the model reads besides each message: the conversation `conversation`
  // keeps (remove it here and from plugins to keep none, and each message is
  // read alone), and the context layers of the plugins listed in `layers`.
  context: { profiles: { default: { conversation, layers: [teamWiki, longTermMemory], budget: { maxChars: 8000 } } } },
  i18n: { locales: { en } },
  // What the agent does, as events in traces/ in Mercury's data folder:
  // a file per day, the last 7 days with activity kept. "meta" records names,
  // outcomes and times; "args" also what the tools were given. Remove to record nothing.
  traces: { sink: jsonlTraces(), level: "meta" },
  // The app's version, from package.json: GET /version shows it next to the
  // framework's, to anyone (no token). Mercury never changes it, and a new
  // one shows once the app is rebuilt. Remove this line to show none.
  version: pkg.version,
});
