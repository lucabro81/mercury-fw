# Model endpoint (Ollama-compatible). Ollama running on the Docker host is host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
# Chat model the assistant runs on
OLLAMA_MODEL=
# Embedding model for the episodic memory
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Qdrant, the compose service
QDRANT_URL=http://qdrant:6333
# Wiki vault, the named volume's mount point
WIKI_VAULT_PATH=/app/wiki-vault
# How long a streaming turn waits for the model's next token before it's stopped with an error (0 turns it off)
TURN_STALL_TIMEOUT_MS=120000

# --- http
# Port of the HTTP surface
HTTP_SURFACE_PORT=4100
# Origin allowed to call the HTTP surface from a browser, if any
HTTP_SURFACE_CORS_ORIGIN=
# Address people's browsers reach the HTTP surface at, for logging in to the services plugins act on as them
HTTP_SURFACE_PUBLIC_URL=
# Characters of a reopened conversation that come back to the model (empty: the core's SESSION_RESUME_MAX_CHARS, 0: off)
HTTP_SURFACE_RESUME_MAX_CHARS=

# --- static
# Required: JSON from bearer token to user, test tokens only: {"<token>": {"id": "alice", "displayName": "Alice"}}
AUTH_STATIC_TOKENS=

# --- jira
# Required: the Jira site the issue links point to (https://<site>.atlassian.net)
JIRA_SITE_URL=
