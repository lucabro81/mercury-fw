# The skill trainer's environment: copy to .env in this folder (Bun loads it
# from the folder the command runs in). The tasks run as real Mercury turns,
# so the model is whatever these say, as for any app.

# The Ollama-compatible endpoint and the model the tasks run on.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
# false for a model without Ollama's extended thinking.
OLLAMA_THINK=true
# The model's temperature, top_p and top_k, as the instance sets them
# (empty: the model's own). A run records them, and compare refuses two runs
# made with different ones.
OLLAMA_TEMPERATURE=
OLLAMA_TOP_P=
OLLAMA_TOP_K=

# Memory beyond the conversation isn't used: point Qdrant somewhere that
# refuses at once, so nothing waits on it.
QDRANT_URL=http://127.0.0.1:9

# What the plugins under training need to build. Their CLI is never run: the
# fixtures answer for it.
JIRA_SITE_URL=https://example.atlassian.net
