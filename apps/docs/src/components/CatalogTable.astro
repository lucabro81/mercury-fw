---
/**
 * The plugin catalog's index: every first-party package by its page's title,
 * with its role, one-line description (the page's own `description`) and
 * version, linked to its page.
 */
import { getEntry } from "astro:content";
import { catalogRows, KIND_LABEL } from "../lib/catalog-data.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rows = await Promise.all(
  catalogRows().map(async (row) => {
    const page = await getEntry("docs", `plugins/${row.slug}`);
    if (!page) throw new Error(`catalog: ${row.package} has no page at plugins/${row.slug}`);
    return { ...row, title: page.data.title, description: page.data.description ?? "" };
  }),
);
---

<table>
  <thead>
    <tr><th scope="col">Plugin</th><th scope="col">Role</th><th scope="col">What it does</th><th scope="col">Version</th></tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <td><a href={`${base}/plugins/${row.slug}/`}>{row.title}</a></td>
        <td>{row.kinds.map((k) => KIND_LABEL[k]).join(", ")}</td>
        <td>{row.description}</td>
        <td>{row.version ?? "not published yet"}</td>
      </tr>
    ))}
  </tbody>
</table>
