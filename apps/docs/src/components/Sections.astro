---
/**
 * The site's four sections as links, the current one marked: in the header on
 * wide screens, at the top of the mobile menu on narrow ones. The caller
 * provides the list element around them and its styles.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
/** Each section with the top-level folders, under the base, whose pages belong to it. */
const sections = [
  { label: "Getting started", href: `${base}/getting-started/first-agent/`, folders: ["getting-started"] },
  { label: "Docs", href: `${base}/concepts/what-mercury-is/`, folders: ["concepts", "reference"] },
  { label: "Plugins", href: `${base}/plugins/`, folders: ["plugins"] },
  { label: "Changelog", href: `${base}/changelog/`, folders: ["changelog"] },
];
const path = Astro.url.pathname;
const isCurrent = (folders: string[]) => folders.some((folder) => path.startsWith(`${base}/${folder}/`));
---

{
  sections.map((s) => (
    <a href={s.href} aria-current={isCurrent(s.folders) ? "page" : undefined}>
      {s.label}
    </a>
  ))
}
