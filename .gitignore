.claude/settings.local.json
.claude/current-scope.md
.claude/hooks/

# Dependencies
node_modules

# Turborepo
.turbo

# Bun — bun.lock (text) IS committed; bun.lockb (binary) is not
bun.lockb

# Build output
dist
build
out

# CLI binaries a tool plugin's postinstall downloads (packages/tools/plugin-*/bin)
bin

# Env — .env.example is the only one that ships
.env
.env.*
!.env.example

# Benchmark run output — regenerated by run.ts, disposable (see
# clear-results.ts); the zip is the actual backup, not this dir or git.
# Unanchored so it holds wherever the harness ends up living in the monorepo.
**/benchmark/results/
**/benchmark/results-*.zip

# Volumes / persisted data (Qdrant, wiki vault, etc.)
data
volumes

# Logs
*.log
logs

# OS / editor
.DS_Store
*.pem
.vscode
.idea
coverage
