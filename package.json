{
  "name": "mercury-monorepo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucabro81/mercury-fw.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test && bun test ./scripts/",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "release": "bun scripts/release.ts",
    "check-pack": "bun scripts/check-pack.ts",
    "publish-packages": "bun scripts/publish.ts",
    "build-types": "bun scripts/build-types.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/types/*",
    "packages/channels/*",
    "packages/auth/*",
    "packages/tools/*",
    "packages/formatters/*",
    "packages/libs/*",
    "packages/config/*"
  ]
}
