{
  "name": "@mercury-fw/plugin-atlassian-admin",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucabro81/mercury-fw.git",
    "directory": "packages/tools/plugin-atlassian-admin"
  },
  "files": [
    "*.ts",
    "dist",
    "atlassian-admin.json",
    "scripts",
    "CHANGELOG.md",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mercury-fw/cli-engine": ">=0.24.0 <1.0.0",
    "@mercury-fw/plugin-types": ">=0.24.0 <1.0.0",
    "@mercury-fw/utils": ">=0.24.0 <1.0.0"
  },
  "devDependencies": {
    "@mercury-fw/cli-engine": "workspace:*",
    "@mercury-fw/plugin-types": "workspace:*",
    "@mercury-fw/typescript-config": "*",
    "@mercury-fw/utils": "workspace:*",
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "mercury-fw-source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "postinstall": "bun run scripts/install-atlassian-admin-cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "mercury": {
    "cliBinary": {
      "repo": "lucabro81/CLI-monorepo",
      "crate": "atlassian-admin",
      "version": "0.1.2"
    },
    "cliCredentials": {
      "folder": "atlassian-admin-cli",
      "setup": ["atlassian-admin", "init"],
      "check": ["atlassian-admin", "doctor"]
    }
  }
}
